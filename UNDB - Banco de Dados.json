      "parameters": {
        "jsCode": "const jid = $input.item.json.Numero || \"\";\nconst cleanJid = jid.replace(/\\D/g, '');\n\nconst getSuffix = (num) => {\n  const clean = num.replace(/\\D/g, '');\n  let withoutCountry = clean;\n  if (clean.startsWith('55') && clean.length > 10) {\n    withoutCountry = clean.substring(2);\n  }\n  return withoutCountry.slice(-8);\n};\n\nconst targetSuffix = getSuffix(cleanJid);\n\n// Acessa os clientes retornados pelo nó anterior\nconst clients = $('Buscar Clientes').all();\nlet matchedClient = null;\n\nfor (const c of clients) {\n  const clientPhone = c.json.telefone_contato || \"\";\n  const clientSuffix = getSuffix(clientPhone);\n  if (clientSuffix && clientSuffix === targetSuffix) {\n    matchedClient = c.json;\n    break;\n  }\n}\n\nreturn {\n  json: {\n    ...$input.item.json,\n    cliente_encontrado: matchedClient ? true : false,\n    cliente_id: matchedClient ? matchedClient.id : null,\n    cliente_nome: matchedClient ? matchedClient.nome : \"Desconhecido\",\n    cliente_dados: matchedClient\n  }\n};"
      },
