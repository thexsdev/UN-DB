      "parameters": {
        "jsCode": "const base64String = items[0].json.base64;\n\n// Se não tiver base64, retorna vazio para não dar erro\nif (!base64String) {\n  return [];\n}\n\nconst binaryData = Buffer.from(base64String, 'base64');\n\nreturn [\n  {\n    json: {\n      fileName: 'audio.mp3'\n    },\n    binary: {\n      data: {\n        data: binaryData.toString('base64'),\n        mimeType: 'audio/mp4', // O WhatsApp geralmente manda mp4/ogg\n        fileName: 'audio.mp3',\n        fileExtension: 'mp3'\n      }\n    }\n  }\n];"
